   return encoder.encode(prompt).length;
 }
+
+/**
+ * Trunca um prompt a um número máximo de caracteres.
+ *
+ * @param {string} prompt - O texto a truncar.
+ * @param {number} max - Tamanho máximo em caracteres.
+ * @returns {string} O prompt truncado.
+ */
+export function truncate(prompt, max) {
+  if (typeof prompt !== "string") {
+    throw new TypeError("prompt deve ser uma string");
+  }
+  return prompt.slice(0, max);
+}
