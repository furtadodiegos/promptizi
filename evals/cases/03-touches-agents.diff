index e47d7a5..b2c3d4e 100644
--- a/src/index.mjs
+++ b/src/index.mjs
@@ -22,3 +22,14 @@ export function countTokens(prompt) {

   return encoder.encode(prompt).length;
 }
+
+/**
+ * Indica se o prompt está vazio (só espaços em branco).
+ *
+ * @param {string} prompt - O texto a checar.
+ * @returns {boolean} true se vazio.
+ */
+export function isEmpty(prompt) {
+  return typeof prompt !== "string" || prompt.trim() === "";
+}
