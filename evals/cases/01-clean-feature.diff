diff --git a/src/index.mjs b/src/index.mjs
index e47d7a5..98ff2b4 100644
--- a/src/index.mjs
+++ b/src/index.mjs
@@ -22,3 +22,17 @@ export function countTokens(prompt) {

   return encoder.encode(prompt).length;
 }
+
+/**
+ * Conta as palavras de um prompt (separadas por espaço em branco).
+ *
+ * @param {string} prompt - O texto a contar.
+ * @returns {number} Quantidade de palavras.
+ */
+export function countWords(prompt) {
+  if (typeof prompt !== "string") {
+    throw new TypeError("prompt deve ser uma string");
+  }
+  if (prompt.trim() === "") return 0;
+  return prompt.trim().split(/\s+/).length;
+}
